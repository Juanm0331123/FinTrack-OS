generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum UserRole {
  USER
  ADMIN
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum EntryCategory {
  SUBSCRIPTION
  FIXED
  POCKET
  SAVINGS
  DEBT
  OTHER
}

enum LeftoverDestination {
  AVAILABLE
  SAVINGS
}

enum DebtStatus {
  ACTIVE
  PAID
}

enum DebtStrategy {
  AVALANCHE
  HIGHEST_PAYMENT
  LOWEST_PAYMENT
  RECOMMENDED
}

model User {
  id                    String           @id @default(uuid()) @db.Uuid
  firstName             String           @map("first_name") @db.VarChar(100)
  lastName              String?          @map("last_name") @db.VarChar(100)
  email                 String           @unique @db.VarChar(255)
  passwordHash          String           @map("password_hash") @db.VarChar(255)
  status                UserStatus       @default(PENDING_VERIFICATION)
  role                  UserRole         @default(USER)
  preferredCurrencyCode String           @default("COP") @map("preferred_currency_code") @db.Char(3)
  timezone              String           @default("UTC") @db.VarChar(100)
  lastLoginAt           DateTime?        @map("last_login_at")
  deletedAt             DateTime?        @map("deleted_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  authTokens            AuthToken[]
  debts                 Debt[]
  financeSettings       FinanceSettings?
  moneyAccounts         MoneyAccount[]
  monthEntries          MonthEntry[]
  monthSheets           MonthSheet[]
  oauthAccounts         OAuthAccount[]
  pocketSpends          PocketSpend[]
  refreshTokens         RefreshToken[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  deviceName String?   @map("device_name") @db.VarChar(150)
  ipAddress  String?   @map("ip_address") @db.VarChar(100)
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(255)
  tokenSalt String?       @map("token_salt") @db.VarChar(255)
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  revokedAt DateTime?     @map("revoked_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, type, revokedAt, usedAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  providerEmail     String?       @map("provider_email") @db.VarChar(255)
  displayName       String?       @map("display_name") @db.VarChar(255)
  avatarUrl         String?       @map("avatar_url")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model FinanceSettings {
  userId                   String       @id @map("user_id") @db.Uuid
  cushionAmount            Decimal      @default(0) @map("cushion_amount") @db.Decimal(14, 2)
  benefitsRate             Decimal      @default(0.08) @map("benefits_rate") @db.Decimal(6, 4)
  redirectDebtOverpayments Boolean      @default(false) @map("redirect_debt_overpayments")
  debtStrategy             DebtStrategy @default(AVALANCHE) @map("debt_strategy")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance_settings")
}

model MoneyAccount {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  name       String       @db.VarChar(60)
  sortOrder  Int          @default(0) @map("sort_order")
  archivedAt DateTime?    @map("archived_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  entries    MonthEntry[]
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("money_accounts")
}

model MonthSheet {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  yearMonth           String              @map("year_month") @db.VarChar(7)
  salary              Decimal             @default(0) @db.Decimal(14, 2)
  benefitsOverride    Decimal?            @map("benefits_override") @db.Decimal(14, 2)
  transportAllowance  Decimal             @default(0) @map("transport_allowance") @db.Decimal(14, 2)
  otherDeductions     Decimal             @default(0) @map("other_deductions") @db.Decimal(14, 2)
  disabilityIncome    Decimal?            @map("disability_income") @db.Decimal(14, 2)
  previousLeftover    Decimal             @default(0) @map("previous_leftover") @db.Decimal(14, 2)
  leftoverDestination LeftoverDestination @default(AVAILABLE) @map("leftover_destination")
  notes               String?             @db.VarChar(500)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  entries             MonthEntry[]
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth])
  @@index([userId])
  @@map("month_sheets")
}

model MonthEntry {
  id        String        @id @default(uuid()) @db.Uuid
  sheetId   String        @map("sheet_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  accountId String?       @map("account_id") @db.Uuid
  debtId    String?       @map("debt_id") @db.Uuid
  concept   String        @db.VarChar(120)
  amount    Decimal?      @db.Decimal(14, 2)
  category  EntryCategory @default(OTHER)
  dueDay    Int?          @map("due_day") @db.SmallInt
  note      String?       @db.VarChar(200)
  isPaid    Boolean       @default(false) @map("is_paid")
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  account   MoneyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  debt      Debt?         @relation(fields: [debtId], references: [id], onDelete: SetNull)
  sheet     MonthSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  spends    PocketSpend[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sheetId, sortOrder])
  @@index([userId])
  @@index([accountId])
  @@index([debtId])
  @@map("month_entries")
}

model PocketSpend {
  id        String     @id @default(uuid()) @db.Uuid
  entryId   String     @map("entry_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  amount    Decimal    @db.Decimal(14, 2)
  note      String?    @db.VarChar(120)
  spentOn   DateTime   @map("spent_on") @db.Date
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  entry     MonthEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, spentOn])
  @@index([userId])
  @@map("pocket_spends")
}

model Debt {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  name                String       @db.VarChar(80)
  lender              String?      @db.VarChar(120)
  datesNote           String?      @map("dates_note") @db.VarChar(120)
  dueDay              Int?         @map("due_day") @db.SmallInt
  totalBalance        Decimal      @default(0) @map("total_balance") @db.Decimal(14, 2)
  sharedAmount        Decimal      @default(0) @map("shared_amount") @db.Decimal(14, 2)
  sharedPercent       Decimal?     @map("shared_percent") @db.Decimal(5, 2)
  sharedWith          String?      @map("shared_with") @db.VarChar(60)
  monthlyRate         Decimal      @default(0) @map("monthly_rate") @db.Decimal(9, 6)
  insuranceRate       Decimal      @default(0) @map("insurance_rate") @db.Decimal(9, 6)
  minimumPayment      Decimal      @default(0) @map("minimum_payment") @db.Decimal(14, 2)
  partnerContribution Decimal      @default(0) @map("partner_contribution") @db.Decimal(14, 2)
  myMinimumOverride   Decimal?     @map("my_minimum_override") @db.Decimal(14, 2)
  paymentCap          Decimal?     @map("payment_cap") @db.Decimal(14, 2)
  status              DebtStatus   @default(ACTIVE)
  notes               String?      @db.VarChar(300)
  sortOrder           Int          @default(0) @map("sort_order")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  entries             MonthEntry[]
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("debts")
}
