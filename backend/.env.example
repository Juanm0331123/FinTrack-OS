# Variables del backend. Este archivo documenta nombres y valores de DESARROLLO; los valores
# reales nunca se versionan. En producción NODE_ENV=production exige configuración segura
# (Secure, https, sslmode=verify-full, secreto de borde…) y el proceso no arranca si falta algo.
PORT=4000
NODE_ENV=development
# LOG_LEVEL=info   # debug | info | warn | error | silent

# Neon: cadena pooled (host con -pooler) que usa la app en runtime.
# Producción: sslmode=verify-full (TLS con verificación de certificado y host).
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"
# Neon: cadena directa (sin -pooler) que usa el CLI de Prisma para migraciones.
DIRECT_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Pool y presupuestos de base de datos (por réplica; Cloud Run tiene como máximo 2).
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=8000
DB_LOCK_TIMEOUT_MS=3000
DB_TRANSACTION_TIMEOUT_MS=10000
# true solo con conexiones directas (no pooler): envía statement/lock timeout al conectar.
DB_STARTUP_TIMEOUTS=false

ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_APP_URL=http://localhost:3000
# Saltos de proxy confiables para calcular la IP del cliente. Cloud Run: 1. Nunca "true".
TRUST_PROXY=false
# Secreto compartido con el proxy de Next (frontend). Obligatorio en producción, >= 32 caracteres.
EDGE_PROXY_SECRET=

JSON_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=8000
METRICS_LOG_INTERVAL_MS=60000

# Límites de tasa (ver docs/qa-backend-remediacion.md).
API_RATE_LIMIT_WINDOW_MS=300000
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
AUTH_ACCOUNT_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=120
AUTH_REGISTER_HOURLY_MAX=10
AUTH_EMAIL_COOLDOWN_MS=60000
AUTH_EMAIL_HOURLY_MAX=5
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_NEUTRAL_RESPONSE_MS=1200
FINANCE_RATE_LIMIT_WINDOW_MS=900000
FINANCE_RATE_LIMIT_MAX=1200
FINANCE_READ_RATE_LIMIT_MAX=300

# JWT: secretos largos, aleatorios y distintos entre sí y entre entornos.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ISSUER=fintrack-os
JWT_ACCESS_AUDIENCE=fintrack-api
JWT_REFRESH_AUDIENCE=fintrack-refresh
JWT_ACCESS_TTL=15m
# Inactividad máxima de una sesión (cada renovación la extiende).
JWT_REFRESH_TTL=7d
# Vida absoluta de una sesión desde el inicio de sesión, aunque se renueve.
SESSION_ABSOLUTE_TTL=30d
REFRESH_REUSE_GRACE_SECONDS=30
AUTH_RETENTION_DAYS=30
EMAIL_VERIFICATION_TTL=10m
PASSWORD_RESET_TTL=10m
PASSWORD_RESET_SESSION_TTL=10m

REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# Solo desarrollo: devuelve códigos de verificación en la respuesta. Prohibido en producción.
EXPOSE_DEV_AUTH_TOKENS=true

# Sin EMAIL_PROVIDER en desarrollo, el correo se imprime en la consola.
EMAIL_PROVIDER=gmail
EMAIL_FROM="FinTrack OS <fintrackos.auth@gmail.com>"
EMAIL_PASSWORD=
EMAIL_REPLY_TO=
EMAIL_SEND_TIMEOUT_MS=10000
# RESEND_API_KEY=

OAUTH_HTTP_TIMEOUT_MS=8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/oauth/github/callback

# Solo pruebas de integración: base PostgreSQL aislada (nunca la de .env de desarrollo).
# TEST_DATABASE_URL=postgresql://fintrack_test:fintrack_test_only@127.0.0.1:55433/fintrack_test
