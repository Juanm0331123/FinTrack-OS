# URL que usa el navegador para la API.
# Desarrollo sin proxy: http://localhost:4000. Producción: el propio dominio del frontend
# (https://<frontend>.vercel.app), porque /api/* se reenvía al segundo proyecto Vercel
# (backend/) desde src/proxy.ts. Nunca apuntar el navegador al dominio del backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Solo servidor (no NEXT_PUBLIC): activan el proxy /api/* hacia el backend.
# BACKEND_ORIGIN=https://<backend>.vercel.app
# Mismo valor que EDGE_PROXY_SECRET del backend (>= 32 caracteres).
# EDGE_PROXY_SECRET=
# VERCEL=1 lo inyecta la plataforma: no añadirlo manualmente. Solo allí se admite
# como IP del visitante el X-Forwarded-For único y válido que fija Vercel.
# Variables de producción solo en Production; no reutilizar secretos en Preview/Development.

# Dominio público final del frontend (sin ruta ni barra final). Hace absolutas las URLs de la imagen
# para compartir (og:image / twitter:image) y activa canonical, sitemap.xml, la línea Sitemap de
# robots.txt y la URL de los datos estructurados de la landing. Sin él, esas URLs apuntan a localhost
# o se omiten.
# NEXT_PUBLIC_SITE_URL=https://<dominio-final>
